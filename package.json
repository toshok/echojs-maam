{
  "name": "maam-fable",
  "version": "0.1.0",
  "description": "A TypeScript transliteration of MAAM (Monadic Abstract Abstracting Machines) — Galois Transformers and Modular Abstract Interpreters — with an example restricted-JS dialect for a self-hosted TypeScript compiler.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/cjs/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node -e \"require('node:fs').writeFileSync('dist/cjs/package.json', JSON.stringify({ type: 'commonjs' }) + '\\n')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "demo": "node --import tsx examples/demo.ts",
    "bench": "node --import tsx examples/bench.ts"
  },
  "dependencies": {
    "@types/estree": "^1.0.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "acorn": "^8.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0"
  }
}
